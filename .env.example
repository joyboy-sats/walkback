# Secrets live on Coolify. Vercel receives only the two variables marked
# "Vercel" below. NEXT_PUBLIC_API_URL is a public origin, not a credential.
# Never put a key, a database URL, or the shared secret behind NEXT_PUBLIC_.

# ── Vercel (frontend) ────────────────────────────────────────────────────────
# Public origin of the Coolify API. Inlined into the client at build time.
NEXT_PUBLIC_API_URL=
# Server-only. Same value as on the Coolify API. The browser posts writes to
# /api/*; the Next server attaches this as a bearer token.
API_SHARED_SECRET=

# ── Coolify API (Dockerfile, port 8080, GET /health) ─────────────────────────
# Everything from here down, plus API_SHARED_SECRET above.
# Browser origin allowed to call the API. Comma-separated if there are several.
CORS_ORIGIN=
PORT=8080

# Private Postgres on the Coolify network. Not reachable from Vercel.
DATABASE_URL=

# ── Coolify worker (same image, command override, no port) ───────────────────
# DATABASE_URL, MEMWAL_*, TATUM_*, AI_GATEWAY_API_KEY, DEMO_MODE.
# Optional. API_SHARED_SECRET and CORS_ORIGIN are not read by the worker.
WORKER_POLL_MS=2000

# ── Walrus Memory (Coolify only — never prefix with NEXT_PUBLIC_) ────────────
# From memory.walrus.xyz → SDK credentials panel
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
# Submission form field MEMWAL_AGENT_ID — believed to be the delegate public key.
# Print it with: npm run smoke   (see "delegate_public_key" in the output)
MEMWAL_AGENT_ID=

# Must be mainnet. Staging is https://relayer-staging.memory.walrus.xyz — do not use.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ── Tatum (Coolify only) ─────────────────────────────────────────────────────
# Copy both values verbatim from the Tatum dashboard.
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
TATUM_RATE_URL=https://api.tatum.io/v4/data/rate/symbol

# ── Model access (claim extraction, Coolify only) ────────────────────────────
# lib/extract.ts passes a string model id ("anthropic/claude-sonnet-4-5"),
# which resolves through the AI Gateway and needs this key.
# Alternative: install @ai-sdk/anthropic, use anthropic("claude-sonnet-4-5"),
# and set ANTHROPIC_API_KEY instead.
AI_GATEWAY_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
DEMO_MODE=live
