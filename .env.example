# Vercel (Next.js pages, read queries, job insert, job status):
#   DATABASE_URL   a Postgres URL Vercel can open
# Leave the provider keys unset there. MEMWAL_PRIVATE_KEY in particular
# belongs on the worker only.
#
# Coolify worker (Dockerfile.worker, no port):
#   DATABASE_URL (internal hostname), MEMWAL_*, TATUM_*, AI_GATEWAY_API_KEY,
#   DEMO_MODE, and the optional worker timings below.
# `npm run seed` uses the worker’s environment.

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Worker timings (Coolify worker only) ─────────────────────────────────────
WORKER_POLL_MS=2000
WORKER_RESOLVE_MS=60000

# ── Walrus Memory (worker only — never prefix with NEXT_PUBLIC_) ─────────────
# From memory.walrus.xyz → SDK credentials panel
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
# Submission form field MEMWAL_AGENT_ID — believed to be the delegate public key.
# Print it with: npm run smoke   (see "delegate_public_key" in the output)
MEMWAL_AGENT_ID=

# Must be mainnet. Staging is https://relayer-staging.memory.walrus.xyz — do not use.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ── Tatum (worker only) ──────────────────────────────────────────────────────
# Copy both values verbatim from the Tatum dashboard.
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
TATUM_RATE_URL=https://api.tatum.io/v4/data/rate/symbol

# ── Model access (claim extraction, worker only) ─────────────────────────────
# lib/extract.ts passes a string model id ("anthropic/claude-sonnet-4-5"),
# which resolves through the AI Gateway and needs this key.
# Alternative: install @ai-sdk/anthropic, use anthropic("claude-sonnet-4-5"),
# and set ANTHROPIC_API_KEY instead.
AI_GATEWAY_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
DEMO_MODE=live
