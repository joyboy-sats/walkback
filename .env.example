# ── Walrus Memory (server-only — never prefix with NEXT_PUBLIC_) ──────────────
# From memory.walrus.xyz → SDK credentials panel
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
# Submission form field MEMWAL_AGENT_ID — believed to be the delegate public key.
# Print it with: npm run smoke   (see "delegate_public_key" in the output)
MEMWAL_AGENT_ID=

# Must be mainnet. Staging is https://relayer-staging.memory.walrus.xyz — do not use.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ── Tatum ────────────────────────────────────────────────────────────────────
# Copy both values verbatim from the Tatum dashboard.
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
TATUM_RATE_URL=https://api.tatum.io/v4/data/rate/symbol

# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=
DEMO_MODE=live
