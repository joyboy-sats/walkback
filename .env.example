# =============================================================================
# DO NOT COPY THIS FILE TO VERCEL.
#
# Vercel builds the Next.js UI only. Copying this file would put DATABASE_URL,
# ADMIN_TOKEN, and the provider keys into a public frontend project.
# On Vercel set exactly one variable: NEXT_PUBLIC_API_URL (section 1).
# =============================================================================

# ── 1. Vercel (frontend) ─────────────────────────────────────────────────────
# Public origin of the Coolify API. Not a credential. Inlined at `next build`.
# No trailing slash. This is the only variable the frontend project gets.
NEXT_PUBLIC_API_URL=

# ── 2. Coolify API (Dockerfile, listens on PORT, GET /health) ────────────────
# Opens Postgres and enqueues jobs. Does not hold the Walrus or Tatum keys.
PORT=8080
DATABASE_URL=
# At least 16 characters. The owner types this into the ingest page. The
# browser keeps it in sessionStorage and sends it as x-admin-token.
ADMIN_TOKEN=
# Vercel origin. Comma-separated if there are several. Preflight from any
# other origin is rejected.
CORS_ORIGIN=

# ── 3. Coolify worker (Dockerfile.worker, no port) ───────────────────────────
# Same private DATABASE_URL. This process holds the provider keys.
# `npm run seed` uses this same set, on the worker host, not on Vercel.
DATABASE_URL=
WORKER_POLL_MS=2000
WORKER_RESOLVE_MS=60000

# Walrus Memory. Never prefix these with NEXT_PUBLIC_.
# From memory.walrus.xyz → SDK credentials panel.
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
# Submission form field MEMWAL_AGENT_ID — the delegate public key from
# getPublicKeyHex(). Public config, not a secret. Print it with: npm run smoke
MEMWAL_AGENT_ID=
# Must be mainnet. Do not use relayer-staging.memory.walrus.xyz.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Tatum. Copy both values from the Tatum dashboard.
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
TATUM_RATE_URL=https://api.tatum.io/v4/data/rate/symbol

# Claim extraction. lib/extract.ts uses an AI Gateway model id.
AI_GATEWAY_API_KEY=
# Gateway model id. Not a secret. Blank uses DeepSeek V4.1 Flash
# (deepseek/deepseek-v4.1-flash) from lib/extract.ts. Worker only.
EXTRACT_MODEL=deepseek/deepseek-v4.1-flash

DEMO_MODE=live
