# Coolify worker. Walrus writes run in this process and nowhere else.
#
# Build:
#   docker build -f Dockerfile.worker -t walkback-worker .
# Start (also the image CMD):
#   node --conditions=react-server --import tsx worker/index.ts
#
# `--conditions=react-server` is required. The database client imports
# `server-only`, which throws under plain Node.
#
# No port and no HEALTHCHECK. The process does not serve HTTP.

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
# tsx is a devDependency. Install it even when the builder sets NODE_ENV=production.
RUN npm ci --include=dev

COPY . .

ENV NODE_ENV=production

CMD ["node", "--conditions=react-server", "--import", "tsx", "worker/index.ts"]
