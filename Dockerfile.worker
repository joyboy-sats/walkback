# Same image as the root Dockerfile. Only the command differs.
# Point a second Coolify service at this file, or reuse the API image and set
# the start command to the CMD below. No port.
#
#   docker build -f Dockerfile.worker -t walkback-worker .
#   docker run --env-file worker.env walkback-worker

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .

ENV NODE_ENV=production

CMD ["node", "--conditions=react-server", "--import", "tsx", "worker/index.ts"]
