{
  "name": "walkback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "reresolve": "node --conditions=react-server --import tsx scripts/reresolve.ts",
    "list:memories": "node --conditions=react-server --import tsx scripts/list-memories.ts",
    "api": "node --conditions=react-server --import tsx server/index.ts",
    "worker": "node --conditions=react-server --import tsx worker/index.ts",
    "check:vercel": "tsx scripts/check-vercel-boundary.ts",
    "db:migrate": "tsx backend/migrate-cli.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mysten-incubation/memwal": "0.1.8",
    "@mysten/seal": "^1.5.1",
    "@mysten/sui": "^2.37.0",
    "@mysten/walrus": "^1.2.36",
    "@radix-ui/react-slot": "^1.5.0",
    "ai": "^5.0.278",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "motion": "^14.5.0",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "description": "Checkable claims, adjudicated onchain, with trust that persists across sessions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/joyboy-sats/walkback"
  }
}
